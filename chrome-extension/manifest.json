{
  "manifest_version": 3,
  "name": "New Tab",
  "short_name": "NewTab",
  "version": "1.0.0",
  "description": "تقویم خورشیدی، اوقات شرعی، ساعت تهران و گجت‌های ویندوز ۷",
  "permissions": [
    "storage",
    "alarms",
    "topSites",
    "favicon"
  ],
  "optional_permissions": [
    "bluetooth"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "همگام"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}